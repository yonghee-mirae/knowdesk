{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KnowDesk",
  "version": "0.1.5",
  "identifier": "dev.knowdesk.search",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "search",
        "title": "KnowDesk",
        "width": 1008,
        "height": 648,
        "minWidth": 1008,
        "minHeight": 648,
        "maxWidth": 1008,
        "maxHeight": 648,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
